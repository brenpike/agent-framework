# Force LF line endings for shell scripts regardless of core.autocrlf
*.sh text eol=lf
# Pin brood test fixtures to LF (regression-proofing against core.autocrlf=true checkouts)
tests/brood/*.json text eol=lf
# Pin jq filters and fix-history test fixtures to LF (same regression-proofing)
*.jq text eol=lf
tests/fix-history/*.json text eol=lf
