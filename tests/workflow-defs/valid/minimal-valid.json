{
  "id": "minimal-valid",
  "version": 1,
  "start": "plan",
  "terminal": ["complete", "blocked"],
  "states": {
    "plan": {
      "type": "agent",
      "description": "A known-good fixture exercising every v1 state type and a loop-back transition.",
      "agent": "hivemind:drone",
      "transitions": {
        "ready": "decide",
        "blocked": "blocked"
      }
    },
    "decide": {
      "type": "decision",
      "owner": "overlord",
      "transitions": {
        "go": "gate",
        "blocked": "blocked"
      }
    },
    "gate": {
      "type": "user_gate",
      "transitions": {
        "approved": "run_skill",
        "rejected": "blocked"
      }
    },
    "run_skill": {
      "type": "skill",
      "skill": "hivemind:molt",
      "transitions": {
        "complete": "decide",
        "done": "complete",
        "blocked": "blocked"
      }
    },
    "complete": { "type": "terminal" },
    "blocked": { "type": "terminal" }
  }
}
