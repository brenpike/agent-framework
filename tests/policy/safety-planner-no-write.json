{
  "rule": "Planner cannot write files",
  "source": {
    "file": "plugin/agents/planner.md",
    "pattern": "write, edit, create, or delete files"
  },
  "consumers": [
    {
      "file": "plugin/agents/planner.md",
      "pattern": "Write",
      "absent": true
    },
    {
      "file": "plugin/agents/planner.md",
      "pattern": "Edit",
      "absent": true
    }
  ]
}
