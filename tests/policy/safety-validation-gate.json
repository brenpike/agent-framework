{
  "rule": "Validation gate",
  "source": {
    "file": "plugin/governance/definitions.md",
    "pattern": "Execute every command listed in the project's `CLAUDE.md` validation section. No duration cap."
  },
  "consumers": [
    {
      "file": "plugin/agents/orchestrator.md",
      "pattern": "Run validation per `${CLAUDE_PLUGIN_ROOT}/governance/definitions.md` (Validation Procedure)"
    },
    {
      "file": "plugin/agents/coder.md",
      "pattern": "run validation per `${CLAUDE_PLUGIN_ROOT}/governance/definitions.md` (Validation Procedure)"
    },
    {
      "file": "plugin/skills/open-plan-pr/SKILL.md",
      "pattern": "Exit 1 with blocker if the procedure returned the Worker Report"
    }
  ]
}
